# Copy this file to .compose.env and fill in your values.
# Used by compose.yaml via env_file: .compose.env

# Port the Node.js app listens on inside the container
PORT=3000

# MongoDB connection URI (used by labs-web)
MONGO_URI=mongodb://admin:changeme@mongo:27017/labsweb?authSource=admin

# Contact inbox shown on the Cairn data-deletion page (/delete). Must be monitored.
CAIRN_PRIVACY_EMAIL=dev@cappylabs.uk

# ── Cairn beta sign-up (cairn.cappylabs.uk/beta) ──────────────────────
# Google Group listed as the testers of the Play closed testing track (alpha). Set it to
# "anyone can join" so testers add themselves.
CAIRN_BETA_ANDROID_GROUP_URL=https://groups.google.com/g/cappylabs-cairn-testers
# Play Console → Testing → Closed testing → Alpha → Testers → "Join on the web" link.
CAIRN_BETA_ANDROID_OPTIN_URL=https://play.google.com/apps/testing/uk.cappylabs.cairn
# TestFlight public link. Leave empty until iOS builds exist: iPhone sign-ups
# wait on a list and are invited automatically on the first deploy after it's set.
CAIRN_BETA_IOS_URL=
# Most testers invited per platform; extra sign-ups wait.
CAIRN_BETA_CAP=100
# Who gets a "new sign-up" email (defaults to CAIRN_PRIVACY_EMAIL).
CAIRN_BETA_NOTIFY=dev@cappylabs.uk

# Outgoing mail (nodemailer connection URL). Unset: emails are logged and skipped.
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=Cairn <dev@cappylabs.uk>

# MongoDB root credentials (used by the mongo service)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme
